# Local secrets and environment
.env
.env.*
!.env.example
app/.envrc
*.key
*.pem
auth.json

# LocalWP generated files
conf/
logs/
app/sql/
app/public/wp-config.php

# Ignore WordPress core by default
app/public/*
!app/public/wp-content/

# Ignore generated and third-party wp-content by default
app/public/wp-content/*

# Track only planned custom themes
!app/public/wp-content/themes/
app/public/wp-content/themes/*
!app/public/wp-content/themes/dentall/
!app/public/wp-content/themes/dentall/**
!app/public/wp-content/themes/dentall-child/
!app/public/wp-content/themes/dentall-child/**

# Track only the project plugin and project mu-plugins
!app/public/wp-content/plugins/
app/public/wp-content/plugins/*
!app/public/wp-content/plugins/dentall-core/
!app/public/wp-content/plugins/dentall-core/**
!app/public/wp-content/mu-plugins/
!app/public/wp-content/mu-plugins/**

# Runtime data
app/public/wp-content/uploads/
app/public/wp-content/cache/
app/public/wp-content/upgrade/
app/public/wp-content/languages/
app/public/wp-content/backups*/
app/public/wp-content/ai1wm-backups/
app/public/wp-content/updraft/
app/public/wp-content/wflogs/
app/public/wp-content/debug.log

# Dependencies and test artifacts
**/node_modules/
**/vendor/
**/dist/
**/build/
**/.cache/
**/coverage/
**/playwright-report/
**/test-results/

# Databases, logs and archives
*.sql
*.sql.gz
*.log
*.zip
*.tar
*.tar.gz

# Backups: track instructions/templates only
backups/*
!backups/README.md
!backups/RELEASE-MANIFEST-TEMPLATE.md

# Design assets: track the policy and register, not large binaries
design-assets/*
!design-assets/README.md

# IDE and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
