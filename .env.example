# 安全变量示例：只记录变量名，不填写真实密钥。
WP_ENV=local
WP_HOME=http://dentall.local
WP_SITEURL=http://dentall.local

# LocalWP已管理本地数据库连接；只有部署流程需要时才补充对应变量。
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=false

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

PAYMENT_MODE=sandbox
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
